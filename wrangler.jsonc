/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudblog",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"r2_buckets": [
		{
			"binding": "STATIC_BUCKET",
			"bucket_name": "cloudblog-images"
		},
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "cloudblog-images"
		}
	],
	"observability": {
		"enabled": true
	},
	// Site logo and footer - managed here in wrangler.jsonc (not Cloudflare Console vars)
	"vars": {
		"SITE_LOGO_TEXT": "FLPT",
		"SITE_FOOTER_TEXT": "© 2024 CloudBlog. All rights reserved."
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloudblog-db",
			"database_id": "4cc7dce4-1285-41a0-80ba-319759c59456"
		}
	],
	"kv_namespaces": [
		{
			"binding": "IMPORT_KV",
			"id": "80a035bc87e041848297f47b2e4c03e5"
		},
		{
			"binding": "SEARCH_KV",
			"id": "ab7e944d29e245c694342fb877c72f91"
		}
	]
}
