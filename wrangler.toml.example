# CloudBlog Wrangler 配置示例
# 复制此文件为 wrangler.toml 并填入你的配置

name = "cloudblog"
main = "src/index.ts"
compatibility_date = "2026-03-10"
assets = "public"

# 本地开发环境配置
[env.local]
kv_namespaces = [
  { binding = "IMPORT_KV", id = "本地KV_ID" },
  { binding = "SEARCH_KV", id = "本地KV_ID" }
]
d1_databases = [
  { binding = "DB", database_name = "cloudblog-db", database_id = "本地数据库ID" }
]
r2_buckets = [
  { binding = "IMAGES_BUCKET", bucket_name = "cloudblog-images" }
]

# 生产环境配置 (CI/CD 使用 wrangler --var 注入)
[env.production]
name = "cloudblog"

[[env.production.kv_namespaces]]
binding = "IMPORT_KV"
id = "${IMPORT_KV_ID}"  # 运行时通过 --var IMPORT_KV_ID=xxx 传入

[[env.production.kv_namespaces]]
binding = "SEARCH_KV"
id = "${SEARCH_KV_ID}"  # 运行时通过 --var SEARCH_KV_ID=xxx 传入

[[env.production.d1_databases]]
binding = "DB"
database_name = "cloudblog-db"
database_id = "${D1_DATABASE_ID}"  # 运行时通过 --var D1_DATABASE_ID=xxx 传入

[[env.production.r2_buckets]]
binding = "IMAGES_BUCKET"
bucket_name = "${R2_BUCKET_NAME}"  # 运行时通过 --var R2_BUCKET_NAME=xxx 传入
