# CloudBlog Wrangler 配置示例
# 复制此文件为 wrangler.toml 并填入你的配置

name = "cloudblog"
main = "src/index.ts"
compatibility_date = "2024-01-01"

# 静态文件目录（包含 HTML/CSS/JS）
assets = "public"

# 本地开发环境配置
[env.local]
kv_namespaces = [
  { binding = "IMPORT_KV", id = "本地KV_ID" },
  { binding = "SEARCH_KV", id = "本地KV_ID" }
]
d1_databases = [
  { binding = "DB", database_name = "cloudblog-db", database_id = "本地数据库ID" }
]
r2_buckets = [
  { binding = "IMAGES_BUCKET", bucket_name = "cloudblog-images" }
]

# 生产环境配置
[env.production]
name = "cloudblog"

[[env.production.kv_namespaces]]
binding = "IMPORT_KV"
id = "填入你的IMPORT_KV_ID"

[[env.production.kv_namespaces]]
binding = "SEARCH_KV"
id = "填入你的SEARCH_KV_ID"

[[env.production.d1_databases]]
binding = "DB"
database_name = "cloudblog-db"
database_id = "填入你的D1数据库ID"

[[env.production.r2_buckets]]
binding = "IMAGES_BUCKET"
bucket_name = "cloudblog-images"
